generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Operação de ano registrada no log (mesmos nomes usados pela trava).
enum OperationType {
  createYear
  repairYear
  deleteYear
}

/// Resultado da operação: `success` para 2xx, `error` para 4xx/5xx.
enum OperationStatus {
  success
  error
}

/// Uma linha por requisição de /years que chega ao handler (sucesso ou erro).
/// `response` é o corpo enviado ao cliente; `error` é a mensagem interna (5xx/inesperado).
model OperationLog {
  id         Int             @id @default(autoincrement())
  year       Int
  operation  OperationType
  status     OperationStatus
  statusCode Int             @map("status_code")
  response   Json
  error      String?
  startedAt  DateTime        @map("started_at")
  finishedAt DateTime        @default(now()) @map("finished_at")
  /// Nulo nas linhas migradas das tabelas antigas (duração desconhecida)
  durationMs Int?            @map("duration_ms")

  @@index([year, startedAt])
  @@map("operation_log")
}

/// Trava por ano: existe uma linha enquanto uma operação (createYear, repairYear ou deleteYear)
/// daquele ano está em andamento. A chave primária garante que só uma operação por ano rode.
model YearOperationLock {
  year      Int      @id
  operation String
  startedAt DateTime @default(now()) @map("started_at")

  @@map("year_operation_lock")
}
