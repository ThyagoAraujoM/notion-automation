generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Operação de ano registrada no log (mesmos nomes usados pela trava).
enum OperationType {
  createYear
  repairYear
  deleteYear
}

/// Resultado da operação: `success` para 2xx, `error` para 4xx/5xx.
enum OperationStatus {
  success
  error
}

/// Uma linha por requisição de /years que chega ao handler (sucesso ou erro).
/// `response` é o corpo enviado ao cliente; `error` é a mensagem interna (5xx/inesperado).
model OperationLog {
  id         Int             @id @default(autoincrement())
  year       Int
  operation  OperationType
  status     OperationStatus
  statusCode Int             @map("status_code")
  response   Json
  error      String?
  startedAt  DateTime        @map("started_at")
  finishedAt DateTime        @default(now()) @map("finished_at")
  /// Nulo nas linhas migradas das tabelas antigas (duração desconhecida)
  durationMs Int?            @map("duration_ms")

  @@index([year, startedAt])
  @@map("operation_log")
}

/// Situação de um job de ano: `running` enquanto roda em segundo plano; `succeeded`/`failed` ao terminar.
enum JobStatus {
  running
  succeeded
  failed
}

/// Operação de ano aceita com 202 e executada em segundo plano (consultada por GET /years/jobs/:id).
/// `statusCode` e `result` são o código e o corpo que a rota síncrona daria; `error` é a mensagem interna.
model YearJob {
  id         String        @id @default(uuid()) @db.Uuid
  year       Int
  operation  OperationType
  status     JobStatus     @default(running)
  /// Parâmetros do pedido (ex.: `{ "startToday": true }`)
  params     Json
  statusCode Int?          @map("status_code")
  result     Json?
  error      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  finishedAt DateTime?     @map("finished_at")

  @@index([year, createdAt])
  @@map("year_job")
}

/// Trava por ano: existe uma linha enquanto uma operação (createYear, repairYear ou deleteYear)
/// daquele ano está em andamento. A chave primária garante que só uma operação por ano rode.
model YearOperationLock {
  year      Int      @id
  operation String
  startedAt DateTime @default(now()) @map("started_at")

  @@map("year_operation_lock")
}
