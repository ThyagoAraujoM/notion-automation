{
  "name": "@notion-automation/api",
  "version": "1.0.0",
  "description": "Api to make automation for notion",
  "scripts": {
    "dev": "pnpm env:load tsx watch ./src/http/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:local": "pnpm env:load node dist/server.js",
    "env:load": "dotenv -e ../../.env --",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm env:load tsx ./src/scripts/e2e-routine.ts",
    "db:generate": "prisma generate",
    "db:migrate": "pnpm env:load prisma migrate dev",
    "db:deploy": "pnpm env:load prisma migrate deploy",
    "db:studio": "pnpm env:load prisma studio",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.3",
    "@notion-automation/env": "workspace:*",
    "@notionhq/client": "^5.22.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@notion-automation/eslint-config": "workspace:*",
    "@notion-automation/typescript-config": "workspace:*",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.1",
    "prisma": "7.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "5.9.2",
    "vitest": "^5.1.1"
  }
}
